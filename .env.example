# ── Copy to .env (never commit .env) ───────────────────────────────
# Private administrator inbox that receives every demo booking.
# Server-side only: it is never sent to the browser or written in the site code.
BOAT_ADMIN_EMAIL=

# Sender shown on notification emails (must be a domain verified with your provider).
MAIL_FROM="BOAT Website <bookings@your-domain.com>"

# Option A — Resend (https://resend.com) HTTP API
RESEND_API_KEY=

# Option B — any SMTP server (used only if RESEND_API_KEY is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Booking storage (recommended for production). Use a Supabase project SEPARATE from the
# BOAT application. Create the table with supabase/demo_bookings.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local fallback directory for bookings.jsonl when Supabase is not configured.
# BOOKINGS_DIR=./data

PORT=3000
